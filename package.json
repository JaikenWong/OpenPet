{
  "name": "panda",
  "version": "0.1.0",
  "description": "A pet companion on desktop",
  "main": "./main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["pet", "companion", "electron"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.panda.app",
    "productName": "Panda",
    "mac": {
      "icon": "build/icon.png",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
